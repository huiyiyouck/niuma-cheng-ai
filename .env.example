HOST=127.0.0.1
PORT=8100

# LLM 多 provider fallback（推荐，ADR-0002）
# JSON 数组，每项含 name/base_url/api_key_env/model（可选 timeout_ms/temperature/
# supports_response_format）。key 通过 api_key_env 指向下方环境变量，勿写入 JSON。
# 生产至少配置 2 个 provider（DevOps 发布检查项2）。
LLM_PROVIDERS_JSON=[{"name":"primary","base_url":"https://api.example.com/v1","api_key_env":"OPENAI_API_KEY","model":"model-a"},{"name":"backup","base_url":"https://api.backup.com/v1","api_key_env":"BACKUP_OPENAI_API_KEY","model":"model-b"}]

# provider api key（被 LLM_PROVIDERS_JSON 的 api_key_env 引用）
OPENAI_API_KEY=
BACKUP_OPENAI_API_KEY=

# 单 provider 兼容路径（未设 LLM_PROVIDERS_JSON 时回退，便于本地冒烟）
OPENAI_BASE_URL=https://api.openai.com/v1
L1_LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000

# 外部搜索（Web 搜索 ai 直连 Tavily，CN-001；未配置时降级不阻塞）
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# 库内检索（主动 KB search，CN-002；ai 回调 xiaobao /v1/kb-search，契约 kb-search.md v1）
# 未配置 KB_SEARCH_URL 时不触发主动 KB 检索、以 needs_context 标记缺口，不阻塞主流程。
KB_SEARCH_URL=http://127.0.0.1:8001/v1/kb-search
KB_ADMIN_TOKEN=

# ── v0.2 新增：运行模式与 DB 数据源（设计 §2.6）────────────────────────
# 进程级开关。缺失或非法 → 回落 http 并 WARN，不会静默进入 db 模式（AC-1.3）。
RUN_MODE=http

# 共享库连接（DB 模式必填）。**按字段拆分，不用整串 DSN**——整串极易被日志、
# ps 输出、驱动异常信息整体带出（O-7）。口令只进 .env，不入仓。
AI_DB_HOST=127.0.0.1
AI_DB_PORT=5432
AI_DB_NAME=news_test
AI_DB_USER=ai_worker
AI_DB_PASSWORD=

# worker 运行参数（O-3 落定）。带不等式的项是**正确性约束**，启动时校验，
# 不满足即拒绝启动并打印算式。
L1_ITEM_BUDGET_MS=240000        # 单条 wall-clock 预算（AC-3.8）
L1_CLAIM_BATCH_SIZE=1           # N=1：串行下 N>1 零吞吐收益却放大风险（ADR-0004）
L1_POLL_INTERVAL_MS=15000       # 队列空时的等待间隔
L1_SHUTDOWN_GRACE_MS=260000     # 须 ≥ N × 预算，且 < 卡死回收阈值
L1_EMPTY_POLL_WARN=20           # 连续空轮多少次后告警（≈5 分钟）
L1_MIN_SEGMENT_MS=1000          # 低于此值即判该段预算不足、跳过而不发起必然超时的调用
AI_WORKER_ID=                   # 缺省取 hostname；lock_token = {worker_id}#{run_token}

# DB 超时三层，须逐层收紧：lock < statement < tx（AC-4.7）
# tx 是**事务级**上限，由应用层 asyncio.wait_for 保证——PG 无内建事务执行超时，
# statement_timeout 是「每条语句」的，一次写回有 3 条语句（CN-008）。
AI_DB_CONNECT_TIMEOUT_MS=1000
AI_DB_TX_TIMEOUT_MS=5000
AI_DB_STATEMENT_TIMEOUT_MS=4000
AI_DB_LOCK_TIMEOUT_MS=3000
AI_DB_POOL_MIN=1
AI_DB_POOL_MAX=3

# 写回事务的瞬时故障有限重试（§4.6）。重试在 ItemBudget 之外。
L1_WRITEBACK_RETRY=2
L1_WRITEBACK_RETRY_DELAY_MS=1000

# 对方的卡死回收阈值。**600s 不是 1800s**——1800 是其契约起草时臆定、无实现
# 依据的数字，实际为其 AI_STALE_TIMEOUT_MS 默认值（契约 v1.7 已回填）。
AI_STALE_TIMEOUT_MS=600000
